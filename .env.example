# Appwrite project (Console -> project Settings, and an API key with all scopes)
APPWRITE_ENDPOINT="https://fra.cloud.appwrite.io/v1"
APPWRITE_PROJECT_ID=""
# Server only. Never prefix with NEXT_PUBLIC_.
APPWRITE_API_KEY=""

# Public address of the site (password-reset links, the reminder function)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"

# Push reminders: generate once with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret between the Appwrite reminder function and /api/cron/reminders
CRON_SECRET=""

# Optional: "Suggest steps" with AI. Without a key the button is hidden.
ANTHROPIC_API_KEY=""

# Only for npm run test:e2e
E2E_BASE_URL="http://localhost:3000"
