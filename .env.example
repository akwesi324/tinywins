# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server only (the reminder job). Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# Public address of the site (email links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Push reminders: generate once with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret for the every-minute reminder job (supabase/schedule-reminders.sql)
CRON_SECRET=""

# Optional: "Suggest steps" with AI. Without a key the button is hidden.
ANTHROPIC_API_KEY=""

# Only for npm run test:e2e
E2E_BASE_URL="http://localhost:3000"
